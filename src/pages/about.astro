<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`About | ${SITE_TITLE}`}
      description="About Nestor Silva, software engineer: skills, experience, and education."
    />
    <style>
      main {
        width: 960px;
      }

      .about-page > section + section {
        margin-top: 5rem;
      }

      .about-section {
        align-items: start;
        padding-top: 1rem;
      }

      .section-eyebrow {
        display: flex;
        align-items: center;
        gap: 0.7rem;
        margin: 0 0 1rem;
        color: var(--color-text-secondary);
        font-family:
          ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.11em;
        line-height: 1;
        text-transform: uppercase;
      }

      .section-number {
        display: inline-grid;
        width: 1.8rem;
        height: 1.8rem;
        place-items: center;
        color: var(--color-accent);
        background: color-mix(in srgb, var(--color-accent) 10%, transparent);
        border: 1px solid
          color-mix(in srgb, var(--color-accent) 22%, transparent);
        border-radius: 50%;
        letter-spacing: 0;
      }

      h1 {
        max-width: 12ch;
        margin: 0;
        font-size: clamp(2.5rem, 7vw, 4.25rem);
        letter-spacing: -0.04em;
        line-height: 0.98;
      }

      .section-heading {
        display: grid;
        grid-template-columns: minmax(10rem, 0.38fr) minmax(0, 0.62fr);
        gap: 2rem;
        align-items: end;
        margin-bottom: 2rem;
      }

      .section-heading .section-eyebrow {
        margin: 0;
      }

      .section-heading h2 {
        margin: 0;
        font-size: clamp(1.75rem, 4vw, 2.5rem);
        letter-spacing: -0.025em;
      }

      .skill-groups {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 3rem 4.5rem;
      }

      .skill-group h3 {
        margin: 0 0 1.25rem;
        padding-bottom: 0.75rem;
        border-bottom: 1px solid var(--color-border-strong);
        font-size: 1rem;
        letter-spacing: 0.01em;
      }

      .skill-list {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1rem 1.5rem;
        margin: 0;
        padding: 0;
        list-style: none;
      }

      .skill {
        position: relative;
        display: flex;
        min-width: 0;
        align-items: center;
        gap: 0.75rem;
        color: var(--color-text);
        font-size: 0.9rem;
        font-weight: 500;
        line-height: 1.25;
        transition:
          color 160ms ease,
          transform 160ms ease;
      }

      .skill-logo {
        position: relative;
        z-index: 1;
        display: block;
        width: 2rem;
        height: 2rem;
        border-radius: 0;
        object-fit: contain;
        transition: transform 160ms ease;
      }

      .skill-logo-frame {
        position: relative;
        display: grid;
        width: 2rem;
        height: 2rem;
        flex: 0 0 2rem;
        place-items: center;
      }

      .experience-list {
        position: relative;
        display: grid;
        gap: 2.75rem;
        margin: 0;
        padding: 0;
        list-style: none;
      }

      .experience-list > li:not(:last-child) .experience-entry::after {
        position: absolute;
        top: 3.5rem;
        bottom: -2.75rem;
        left: 1.75rem;
        width: 1px;
        background: var(--color-border-strong);
        content: "";
        transform: translateX(-50%);
      }

      .experience-entry {
        position: relative;
        display: grid;
        grid-template-columns: 3.5rem minmax(0, 1fr);
        gap: 1.25rem;
        align-items: start;
      }

      .experience-logo {
        position: relative;
        z-index: 1;
        display: grid;
        width: 3.5rem;
        height: 3.5rem;
        place-items: center;
        color: var(--color-text-inverse);
        background: linear-gradient(
          135deg,
          var(--color-primary),
          var(--color-accent)
        );
        border-radius: 0.4rem;
        box-shadow: 0 0 0 0.45rem var(--color-background);
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.04em;
      }

      @property --experience-trace-angle {
        syntax: "<angle>";
        inherits: false;
        initial-value: 0deg;
      }

      .experience-logo::before,
      .experience-logo::after {
        position: absolute;
        z-index: 3;
        inset: -0.2rem;
        padding: 4px;
        background: conic-gradient(
          from var(--experience-trace-angle),
          transparent 0deg 285deg,
          color-mix(in srgb, var(--color-primary) 65%, transparent) 305deg,
          var(--color-primary) 324deg,
          var(--color-accent) 338deg,
          var(--color-primary) 350deg,
          transparent 360deg
        );
        border-radius: 0.5rem;
        content: "";
        opacity: 0;
        pointer-events: none;
        transition: opacity 180ms ease;
        -webkit-mask:
          linear-gradient(#000 0 0) content-box,
          linear-gradient(#000 0 0);
        mask:
          linear-gradient(#000 0 0) content-box,
          linear-gradient(#000 0 0);
        -webkit-mask-composite: xor;
        mask-composite: exclude;
      }

      .experience-logo::before {
        filter: blur(0.42rem) brightness(2);
      }

      .experience-logo::after {
        filter: brightness(1.45)
          drop-shadow(
            0 0 0.14rem color-mix(in srgb, var(--color-accent) 85%, transparent)
          );
      }

      .experience-entry:hover .experience-logo::before,
      .experience-entry:hover .experience-logo::after {
        animation: spin-experience-trace 1.5s linear infinite;
        opacity: 1;
      }

      .experience-entry:hover .experience-logo::before {
        opacity: 0.85;
      }

      @keyframes spin-experience-trace {
        to {
          --experience-trace-angle: 360deg;
        }
      }

      @property --skill-trace-angle {
        syntax: "<angle>";
        inherits: false;
        initial-value: 0deg;
      }

      .skill::before,
      .skill::after {
        position: absolute;
        z-index: 3;
        inset: -0.4rem;
        padding: 1px;
        background: conic-gradient(
          from var(--skill-trace-angle),
          transparent 0deg 285deg,
          color-mix(in srgb, var(--color-primary) 65%, transparent) 305deg,
          var(--color-primary) 324deg,
          var(--color-accent) 338deg,
          var(--color-primary) 350deg,
          transparent 360deg
        );
        border-radius: 0.4rem;
        content: "";
        opacity: 0;
        pointer-events: none;
        transition: opacity 180ms ease;
        -webkit-mask:
          linear-gradient(#000 0 0) content-box,
          linear-gradient(#000 0 0);
        mask:
          linear-gradient(#000 0 0) content-box,
          linear-gradient(#000 0 0);
        -webkit-mask-composite: xor;
        mask-composite: exclude;
      }

      .skill::before {
        filter: blur(0.42rem) brightness(2);
      }

      .skill::after {
        filter: brightness(1.45)
          drop-shadow(
            0 0 0.14rem color-mix(in srgb, var(--color-accent) 85%, transparent)
          );
      }

      .skill:hover::before,
      .skill:hover::after {
        animation: spin-skill-trace 1.4s linear infinite;
        opacity: 1;
      }

      .skill:hover::before {
        opacity: 0.85;
      }

      @keyframes spin-skill-trace {
        to {
          --skill-trace-angle: 360deg;
        }
      }

      .experience-logo-initials {
        position: relative;
        z-index: 0;
      }

      .experience-logo-image {
        position: absolute;
        z-index: 1;
        inset: 0;
        display: block;
        width: 100%;
        height: 100%;
        border-radius: inherit;
        object-fit: cover;
      }

      .experience-content {
        min-width: 0;
      }

      .experience-heading {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 1.5rem;
        align-items: start;
      }

      .experience-heading h3 {
        margin: 0;
        font-size: 1.05rem;
        line-height: 1.3;
      }

      .experience-company {
        margin: 0.2rem 0 0;
        color: var(--color-text-secondary);
        font-size: 0.875rem;
        line-height: 1.4;
      }

      .experience-period {
        min-width: max-content;
      }

      .experience-date {
        margin: 0;
        color: var(--color-text-secondary);
        font-family:
          ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 0.82rem;
        letter-spacing: 0.02em;
        line-height: 1.4;
        text-align: right;
      }

      .experience-status {
        display: block;
        width: fit-content;
        margin: 0.45rem 0 0 auto;
        padding: 0.2rem 0.55rem;
        color: var(--color-accent);
        background: color-mix(in srgb, var(--color-accent) 10%, transparent);
        border: 1px solid
          color-mix(in srgb, var(--color-accent) 24%, transparent);
        border-radius: 999px;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        line-height: 1.2;
      }

      .experience-highlights {
        display: grid;
        gap: 0.55rem;
        max-width: 70ch;
        margin: 1.25rem 0 0;
        padding: 0;
        list-style: none;
      }

      .experience-highlights li {
        display: grid;
        grid-template-columns: 1rem minmax(0, 1fr);
        gap: 0.45rem;
        color: var(--color-text);
        font-size: 0.9rem;
        line-height: 1.55;
      }

      .experience-highlights li::before {
        color: var(--color-accent);
        content: "•";
      }

      .experience-technologies {
        display: flex;
        flex-wrap: wrap;
        gap: 0.45rem;
        margin: 1.15rem 0 0;
        padding: 0;
        list-style: none;
      }

      .experience-tag {
        padding: 0.3rem 0.6rem;
        color: var(--color-text-secondary);
        background: color-mix(
          in srgb,
          var(--color-surface-strong) 74%,
          transparent
        );
        border: 1px solid var(--color-border-light);
        border-radius: 0.3rem;
        font-family:
          ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 0.7rem;
        line-height: 1;
      }

      @media (max-width: 820px) {
        .about-section {
          grid-template-columns: 1fr;
          gap: 1.5rem;
        }

        .about-copy {
          max-width: 42rem;
          padding-top: 0;
        }

        .skill-groups {
          gap: 2.5rem 2rem;
        }
      }

      @media (max-width: 600px) {
        .about-page > section + section {
          margin-top: 3.75rem;
        }

        .section-heading {
          grid-template-columns: 1fr;
          gap: 0.9rem;
          align-items: start;
          margin-bottom: 1.35rem;
        }

        .skill-groups {
          grid-template-columns: 1fr;
          gap: 2.5rem;
        }

        .experience-entry {
          grid-template-columns: 3rem minmax(0, 1fr);
          gap: 0.85rem;
        }

        .experience-list {
          gap: 2.25rem;
        }

        .experience-list > li:not(:last-child) .experience-entry::after {
          top: 3rem;
          bottom: -2.25rem;
          left: 1.5rem;
        }

        .experience-logo {
          width: 3rem;
          height: 3rem;
        }

        .experience-heading {
          grid-template-columns: 1fr;
          gap: 0.5rem;
        }

        .experience-date {
          text-align: left;
        }

        .experience-period {
          display: flex;
          min-width: 0;
          flex-wrap: wrap;
          align-items: center;
          gap: 0.5rem;
        }

        .experience-status {
          display: inline-block;
          margin: 0;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .skill,
        .skill-logo {
          transition: none;
        }

        .skill:hover,
        .skill:hover .skill-logo {
          transform: none;
        }

        .experience-logo::before,
        .experience-logo::after {
          transition: none;
        }

        .experience-entry:hover .experience-logo::before,
        .experience-entry:hover .experience-logo::after {
          animation: none;
        }

        .skill::before,
        .skill::after {
          transition: none;
        }

        .skill:hover::before,
        .skill:hover::after {
          animation: none;
        }
      }
    </style>
  </head>
  <body>
    <Header />
    <main class="about-page">
      <section class="about-section" id="about" aria-labelledby="about-title">
        <div data-reveal>
          <p class="section-eyebrow" id="about-title">// About me</p>
        </div>
        <div class="about-copy">
          <p data-reveal>
            Hi, I’m Nestor, a backend-focused senior software engineer with more
            than five years of experience building scalable systems, APIs,
            enterprise applications, automation, and data-driven products. My
            strongest background is in Python, but I also work across Kotlin,
            TypeScript, Java, and React when a solution calls for it.
          </p>
          <p data-reveal>
            I care as much about the product as I do about the code. Good
            technical decisions begin with understanding the problem, the users,
            the business context, and the trade-offs. I enjoy solving difficult
            problems and finding simpler, more efficient ways to deliver useful,
            reliable software.
          </p>
          <p data-reveal>
            AI-powered systems are now one of my main areas of focus. I build
            practical, production-ready solutions with technologies including
            Python, FastAPI, React, REST APIs, AWS, Docker, Odoo, PostgreSQL,
            and TypeScript, applying AI where it creates measurable value rather
            than adding complexity for its own sake.
          </p>
          <p data-reveal>
            I’m currently open to Software Engineer, Backend Engineer, and AI
            Engineer opportunities that include relocation.
          </p>
        </div>
      </section>

      <section id="skills" aria-labelledby="skills-title">
        <div class="section-heading" data-reveal>
          <p class="section-eyebrow" id="skills-title">// Skills</p>
        </div>
        <div class="skill-groups">
          {
            skillGroups.map((group) => (
              <section class="skill-group" aria-label={group.title} data-reveal>
                <h3>{group.title}</h3>
                <ul class="skill-list">
                  {group.skills.map((skill) => (
                    <li class="skill">
                      <span class="skill-logo-frame" aria-hidden="true">
                        <img
                          class="skill-logo"
                          src={skill.logo}
                          alt=""
                          width="32"
                          height="32"
                          loading="lazy"
                        />
                      </span>
                      <span>{skill.name}</span>
                    </li>
                  ))}
                </ul>
              </section>
            ))
          }
        </div>
      </section>

      <section id="experience" aria-labelledby="experience-title">
        <div class="section-heading" data-reveal>
          <p class="section-eyebrow" id="experience-title">// Experience</p>
        </div>
        <!-- Replace these placeholder entries with your real roles and dates. -->
        <ol class="experience-list">
          {
            experience.map((item) => (
              <li data-reveal>
                <article class="experience-entry">
                  <div class="experience-logo" aria-hidden="true">
                    {item.logo ? (
                      <img
                        class="experience-logo-image"
                        src={item.logo}
                        alt=""
                        width="56"
                        height="56"
                        loading="lazy"
                      />
                    ) : (
                      <span class="experience-logo-initials">
                        {item.companyInitials}
                      </span>
                    )}
                  </div>
                  <div class="experience-content">
                    <div class="experience-heading">
                      <div>
                        <h3>{item.role}</h3>
                        <p class="experience-company">{item.company}</p>
                      </div>
                      <div class="experience-period">
                        <p class="experience-date">{item.dates}</p>
                        {item.status && (
                          <span class="experience-status">{item.status}</span>
                        )}
                      </div>
                    </div>
                    <ul class="experience-highlights">
                      {item.highlights.map((highlight) => (
                        <li>{highlight}</li>
                      ))}
                    </ul>
                    <ul
                      class="experience-technologies"
                      aria-label={`Technologies used at ${item.company}`}
                    >
                      {item.technologies.map((technology) => (
                        <li class="experience-tag">{technology}</li>
                      ))}
                    </ul>
                  </div>
                </article>
              </li>
            ))
          }
        </ol>
      </section>

      <section id="education" aria-labelledby="education-title">
        <div class="section-heading" data-reveal>
          <p class="section-eyebrow" id="education-title">// Education</p>
        </div>
        <ol class="experience-list">
          {
            education.map((item) => (
              <li data-reveal>
                <article class="experience-entry">
                  <div class="experience-logo" aria-hidden="true">
                    {item.logo ? (
                      <img
                        class="experience-logo-image"
                        src={item.logo}
                        alt=""
                        width="56"
                        height="56"
                        loading="lazy"
                      />
                    ) : (
                      <span class="experience-logo-initials">
                        {item.institutionInitials}
                      </span>
                    )}
                  </div>
                  <div class="experience-content">
                    <div class="experience-heading">
                      <div>
                        <h3>{item.institution}</h3>
                        {item.qualification && (
                          <p class="experience-company">
                            {item.qualification}
                          </p>
                        )}
                      </div>
                      <div class="experience-period">
                        <p class="experience-date">{item.dates}</p>
                        {item.status && (
                          <span class="experience-status">{item.status}</span>
                        )}
                      </div>
                    </div>
                    <ul class="experience-highlights">
                      {item.highlights.map((highlight) => (
                        <li>{highlight}</li>
                      ))}
                    </ul>
                    <ul
                      class="experience-technologies"
                      aria-label={`Areas of study at ${item.institution}`}
                    >
                      {item.subjects.map((subject) => (
                        <li class="experience-tag">{subject}</li>
                      ))}
                    </ul>
                  </div>
                </article>
              </li>
            ))
          }
        </ol>
      </section>
    </main>
    <Footer />
  </body>
</html>
