                    ></path>
                  </svg>
                  <span class="sr-only">View source on GitHub</span>
                </a>
                <a
                  class="icon-button"
                  href="https://example.com/"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="Open Project Two live demo"
                  title="Open live demo"
                >
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M13 3H4a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-3"></path>
                    <path d="m17 8 5-5"></path>
                    <path d="M17 3h5v5"></path>
                    <path d="M12 17v4"></path>
                    <path d="M8 21h8"></path>
                  </svg>
                  <span class="sr-only">Open live demo</span>
                </a>
              </div>
            </div>
          </li>

          <li class="project-card">
            <div class="project-media">
              <Image
                src={ProjectThreeImage}
                width={720}
                height={360}
                alt="Preview of Project Three"
              />
            </div>
            <div class="project-details">
              <h2 class="project-title">Project Three</h2>
              <p class="project-description">
                A polished interface for discovering, organizing, and sharing
                useful information in one place.
              </p>
              <div class="tag-list" aria-label="Technologies used">
                <span class="tag-chip">Astro</span>
                <span class="tag-chip">JavaScript</span>
                <span class="tag-chip">API</span>
              </div>
              <div class="project-actions">
                <a
                  class="icon-button github"
                  href="https://github.com/"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="View Project Three source on GitHub"
                  title="View source on GitHub"
                >
                  <svg viewBox="0 0 16 16" aria-hidden="true">
                    <path
                      d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
                    ></path>
                  </svg>
                  <span class="sr-only">View source on GitHub</span>
                </a>
                <a
                  class="icon-button"
                  href="https://example.com/"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="Open Project Three live demo"
                  title="Open live demo"
                >
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M13 3H4a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-3"></path>
                    <path d="m17 8 5-5"></path>
                    <path d="M17 3h5v5"></path>
                    <path d="M12 17v4"></path>
                    <path d="M8 21h8"></path>
                  </svg>
                  <span class="sr-only">Open live demo</span>
                </a>
              </div>
            </div>
          </li>
        </ul>
      </section>
    </main>
    <Footer />
  </body>
</html>
