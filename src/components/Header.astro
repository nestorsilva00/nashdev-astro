---
import { SITE_TITLE } from "../consts";
import ChatSidebar from "./ChatSidebar.astro";
import HeaderLink from "./HeaderLink.astro";
import SocialLinks from "./SocialLinks.astro";

const currentSection =
  Astro.url.pathname
    .replace(import.meta.env.BASE_URL, "")
    .split("/")
    .filter(Boolean)[0] ?? "";
---

<header data-reveal="header">
  <nav aria-label="Primary navigation">
    <h2>
      <a class="terminal-brand" href="/" aria-label={`${SITE_TITLE} home`}>
        <span class="brand-icon" aria-hidden="true">&lt;/&gt;</span>
        <span class="cwd" aria-hidden="true">~/</span>
        <span
          class="path"
          data-current-path
          data-path={currentSection}
          aria-hidden="true"></span>
        <span class="cursor" aria-hidden="true"></span>
      </a>
    </h2>
    <div class="nav-right">
      <button
        class="menu-button"
        type="button"
        aria-label="Toggle navigation menu"
        aria-controls="primary-links"
        aria-expanded="false"
        data-menu-button
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
      <div class="internal-links" id="primary-links" data-menu>
        <HeaderLink href="/blog">Blog</HeaderLink>
        <HeaderLink href="/projects">Projects</HeaderLink>
        <HeaderLink href="/about">About</HeaderLink>
      </div>
      <SocialLinks variant="header" />
      <button
        class="theme-toggle"
        type="button"
        aria-label="Switch to dark mode"
        aria-pressed="false"
        title="Switch to dark mode"
        data-theme-toggle
      >
        <svg
          class="theme-icon theme-icon-moon"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9"></path>
        </svg>
        <svg
          class="theme-icon theme-icon-sun"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2"></path>
          <path d="M12 20v2"></path>
          <path d="m4.93 4.93 1.41 1.41"></path>
          <path d="m17.66 17.66 1.41 1.41"></path>
          <path d="M2 12h2"></path>
          <path d="M20 12h2"></path>
          <path d="m6.34 17.66-1.41 1.41"></path>
          <path d="m19.07 4.93-1.41 1.41"></path>
        </svg>
        <span class="sr-only">Toggle color theme</span>
      </button>
      <button
        class="chat-toggle"
        type="button"
        aria-label="Open Ask Nestor"
        aria-controls="chat-panel"
        aria-expanded="false"
        data-chat-toggle
      >
        <span class="chat-toggle-icon" aria-hidden="true"></span>
        <span class="sr-only">Open Ask Nestor</span>
      </button>
    </div>
  </nav>
</header>

<ChatSidebar />

<script>
  const menuButton = document.querySelector("[data-menu-button]");
  const menu = document.querySelector("[data-menu]");
  const navRight = document.querySelector(".nav-right");
  const themeToggle = document.querySelector<HTMLButtonElement>(
    "[data-theme-toggle]",
  );
  const currentPath = document.querySelector<HTMLElement>(
    "[data-current-path]",
  );

  const typeCurrentPath = () => {
    if (!currentPath) return;

    const path = currentPath.dataset.path ?? "";
    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    if (prefersReducedMotion || !path) {
      currentPath.textContent = path;
      return;
    }

    currentPath.textContent = "";
    let characterIndex = 0;

    const typeCharacter = () => {
      if (characterIndex <= path.length) {
        currentPath.textContent = path.slice(0, characterIndex);
        characterIndex += 1;
        window.setTimeout(typeCharacter, 70);
      }
    };

    window.setTimeout(typeCharacter, 260);
  };

  const closeMenu = () => {
    menu?.classList.remove("is-open");
    menuButton?.setAttribute("aria-expanded", "false");
  };

  const updateThemeToggle = () => {
    const isDark = document.documentElement.dataset.theme === "dark";
    const nextTheme = isDark ? "light" : "dark";

    themeToggle?.setAttribute("aria-pressed", String(isDark));
    themeToggle?.setAttribute("aria-label", `Switch to ${nextTheme} mode`);
    themeToggle?.setAttribute("title", `Switch to ${nextTheme} mode`);
  };

  menuButton?.addEventListener("click", () => {
    const isOpen = menu?.classList.toggle("is-open") ?? false;
    menuButton.setAttribute("aria-expanded", String(isOpen));
  });

  document.addEventListener("click", (event) => {
    if (event.target instanceof Node && !navRight?.contains(event.target)) {
      closeMenu();
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      closeMenu();
    }
  });

  themeToggle?.addEventListener("click", () => {
    const nextTheme =
      document.documentElement.dataset.theme === "dark" ? "light" : "dark";

    document.documentElement.dataset.theme = nextTheme;
    document
      .querySelector<HTMLMetaElement>("[data-theme-color]")
      ?.setAttribute("content", nextTheme === "dark" ? "#10141e" : "#ffffff");

    try {
      localStorage.setItem("site-theme", nextTheme);
    } catch {
      // The chosen theme still applies when storage is unavailable.
    }

    updateThemeToggle();
  });

  updateThemeToggle();
  typeCurrentPath();
</script>

<style>
  header {
    position: sticky;
    z-index: 100;
    top: 1rem;
    padding: 0 1rem;
  }
  h2 {
    margin: 0;
    font-size: inherit;
  }
  nav {
    --header-control-size: 2.1rem;
    --header-icon-gap: 0.125rem;
    --header-item-gap: 0.75rem;

    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.875rem;
    width: 100%;
    max-width: 920px;
    min-height: 36px;
    margin: 0 auto;
    padding: 0.5625rem 0.75rem 0.5625rem 1rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border-light);
    border-radius: 1rem;
    box-shadow:
      0 1px color-mix(in srgb, var(--color-background) 80%, transparent) inset,
      0 12px 14px -20px
        color-mix(in srgb, var(--color-text-strong) 45%, transparent);
    backdrop-filter: blur(14px) saturate(140%);
  }
  .terminal-brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-text-secondary);
    font-family:
      ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.875rem;
    font-weight: 500;
    white-space: nowrap;
    text-decoration: none;
  }
  .brand-icon {
    display: grid;
    place-items: center;
    width: 1.375rem;
    height: 1.375rem;
    color: var(--color-text-inverse);
    background: linear-gradient(135deg, #21b4e1, #7b6cff);
    border-radius: 0.3125rem;
    font-size: 0.5625rem;
    font-weight: 700;
    letter-spacing: -0.12em;
  }
  .cwd {
    color: var(--color-text-secondary);
  }
  .path {
    color: var(--color-accent);
  }
  .cursor {
    width: 0.5rem;
    height: 1rem;
    margin-left: 0.125rem;
    background: var(--color-accent);
    animation: blink 1.05s steps(2, end) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .nav-right,
  .internal-links {
    display: flex;
    align-items: center;
    gap: var(--header-item-gap);
  }
  .nav-right {
    position: relative;
  }
  .menu-button,
  .theme-toggle,
  .chat-toggle {
    width: var(--header-control-size);
    height: var(--header-control-size);
    color: var(--color-text-secondary);
    background: transparent;
    border: 0;
    border-radius: 50%;
    cursor: pointer;
    transition:
      color 150ms ease,
      background-color 150ms ease,
      transform 200ms ease;
  }
  .menu-button:hover,
  .theme-toggle:hover,
  .chat-toggle:hover {
    color: var(--color-text-strong);
    background: var(--color-surface-hover);
    transform: scale(1.1);
  }
  .menu-button svg,
  .theme-toggle svg {
    width: 1.125rem;
    height: 1.125rem;
  }
  .menu-button {
    display: none;
    align-items: center;
    justify-content: center;
  }
  .menu-button svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
  }
  .theme-toggle svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .theme-toggle,
  .chat-toggle {
    display: grid;
    place-items: center;
    line-height: 0;
  }
  .chat-toggle-icon {
    display: block;
    width: 1.125rem;
    height: 1.125rem;
    background: currentColor;
    -webkit-mask: url("/chat-sparkle.svg?v=5") center / contain no-repeat;
    mask: url("/chat-sparkle.svg?v=5") center / contain no-repeat;
  }
  .chat-toggle {
    margin-left: calc(var(--header-icon-gap) - var(--header-item-gap));
  }
  .theme-icon-sun {
    display: none;
  }
  :global(html[data-theme="dark"]) .theme-icon-moon {
    display: none;
  }
  :global(html[data-theme="dark"]) .theme-icon-sun {
    display: block;
  }
  @media (prefers-reduced-motion: reduce) {
    .cursor {
      animation: none;
    }
  }
  @media (max-width: 640px) {
    header {
      top: 0.75rem;
      padding: 0 0.75rem;
    }
    nav {
      min-height: 52px;
      padding: 0.4375rem 0.5rem 0.4375rem 0.75rem;
    }
    .menu-button {
      display: flex;
    }
    .internal-links {
      position: absolute;
      z-index: 110;
      top: calc(100% + 0.75rem);
      right: 0;
      display: none;
      flex-direction: column;
      align-items: stretch;
      gap: var(--header-item-gap);
      min-width: 11rem;
      padding: 0.4375rem;
      background: var(--color-surface-strong);
      border: 1px solid var(--color-border-strong);
      border-radius: 0.875rem;
      box-shadow: 0 1.25rem 3rem -1rem
        color-mix(in srgb, var(--color-text-strong) 35%, transparent);
      backdrop-filter: blur(16px);
    }
    .internal-links.is-open {
      display: flex;
    }
  }
</style>
