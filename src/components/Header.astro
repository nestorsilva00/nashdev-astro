---
import { SITE_TITLE } from "../consts";
import HeaderLink from "./HeaderLink.astro";

const currentSection =
  Astro.url.pathname
    .replace(import.meta.env.BASE_URL, "")
    .split("/")
    .filter(Boolean)[0] ?? "";
---

<header>
  <nav aria-label="Primary navigation">
    <h2>
      <a class="terminal-brand" href="/" aria-label={`${SITE_TITLE} home`}>
        <span class="brand-icon" aria-hidden="true">&lt;/&gt;</span>
        <span class="cwd" aria-hidden="true">~/</span>
        <span
          class="path"
          data-current-path
          data-path={currentSection}
          aria-hidden="true">{currentSection}</span
        >
        <span class="cursor" aria-hidden="true"></span>
      </a>
    </h2>
    <div class="nav-right">
      <button
        class="menu-button"
        type="button"
        aria-label="Toggle navigation menu"
        aria-controls="primary-links"
        aria-expanded="false"
        data-menu-button
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
      <div class="internal-links" id="primary-links" data-menu>
        <HeaderLink href="/blog">Blog</HeaderLink>
        <HeaderLink href="/projects">Projects</HeaderLink>
        <HeaderLink href="/about">About</HeaderLink>
      </div>
      <button
        class="theme-toggle"
        type="button"
        aria-label="Switch to dark mode"
        aria-pressed="false"
        title="Switch to dark mode"
        data-theme-toggle
      >
        <svg
          class="theme-icon theme-icon-moon"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9"></path>
        </svg>
        <svg
          class="theme-icon theme-icon-sun"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2"></path>
          <path d="M12 20v2"></path>
          <path d="m4.93 4.93 1.41 1.41"></path>
          <path d="m17.66 17.66 1.41 1.41"></path>
          <path d="M2 12h2"></path>
          <path d="M20 12h2"></path>
          <path d="m6.34 17.66-1.41 1.41"></path>
          <path d="m19.07 4.93-1.41 1.41"></path>
        </svg>
        <span class="sr-only">Toggle color theme</span>
      </button>
      <div class="social-links">
        <a
          href="https://www.linkedin.com/in/nestorsilvahernandez/"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="sr-only">Visit LinkedIn</span>
          <svg viewBox="0 0 24 24" aria-hidden="true" width="32" height="32"
            ><path
              fill="currentColor"
              d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V8.98h3.42v1.57h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.29zM5.32 7.41a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14zm1.78 13.04H3.54V8.98H7.1v11.47z"
            ></path></svg
          >
        </a>
        <a href="https://twitter.com/astrodotbuild" target="_blank">
          <span class="sr-only">Follow Astro on Twitter</span>
          <svg viewBox="0 0 16 16" aria-hidden="true" width="32" height="32"
            ><path
              fill="currentColor"
              d="M5.026 15c6.038 0 9.341-5.003 9.341-9.334 0-.14 0-.282-.006-.422A6.685 6.685 0 0 0 16 3.542a6.658 6.658 0 0 1-1.889.518 3.301 3.301 0 0 0 1.447-1.817 6.533 6.533 0 0 1-2.087.793A3.286 3.286 0 0 0 7.875 6.03a9.325 9.325 0 0 1-6.767-3.429 3.289 3.289 0 0 0 1.018 4.382A3.323 3.323 0 0 1 .64 6.575v.045a3.288 3.288 0 0 0 2.632 3.218 3.203 3.203 0 0 1-.865.115 3.23 3.23 0 0 1-.614-.057 3.283 3.283 0 0 0 3.067 2.277A6.588 6.588 0 0 1 .78 13.58a6.32 6.32 0 0 1-.78-.045A9.344 9.344 0 0 0 5.026 15z"
            ></path></svg
          >
        </a>
        <a href="https://github.com/withastro/astro" target="_blank">
          <span class="sr-only">Go to Astro's GitHub repo</span>
          <svg viewBox="0 0 16 16" aria-hidden="true" width="32" height="32"
            ><path
              fill="currentColor"
              d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
            ></path></svg
          >
        </a>
      </div>
    </div>
  </nav>
</header>

<script>
  const menuButton = document.querySelector("[data-menu-button]");
  const menu = document.querySelector("[data-menu]");
  const navRight = document.querySelector(".nav-right");
  const themeToggle = document.querySelector<HTMLButtonElement>(
    "[data-theme-toggle]",
  );
  const currentPath = document.querySelector<HTMLElement>(
    "[data-current-path]",
  );

  const typeCurrentPath = () => {
    if (!currentPath) return;

    const path = currentPath.dataset.path ?? "";
    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    if (prefersReducedMotion || !path) {
      currentPath.textContent = path;
      return;
    }

    currentPath.textContent = "";
    let characterIndex = 0;

    const typeCharacter = () => {
      if (characterIndex <= path.length) {
        currentPath.textContent = path.slice(0, characterIndex);
        characterIndex += 1;
        window.setTimeout(typeCharacter, 70);
      }
    };

    window.setTimeout(typeCharacter, 260);
  };

  const closeMenu = () => {
    menu?.classList.remove("is-open");
    menuButton?.setAttribute("aria-expanded", "false");
  };

  const updateThemeToggle = () => {
    const isDark = document.documentElement.dataset.theme === "dark";
    const nextTheme = isDark ? "light" : "dark";

    themeToggle?.setAttribute("aria-pressed", String(isDark));
    themeToggle?.setAttribute("aria-label", `Switch to ${nextTheme} mode`);
    themeToggle?.setAttribute("title", `Switch to ${nextTheme} mode`);
  };

  menuButton?.addEventListener("click", () => {
    const isOpen = menu?.classList.toggle("is-open") ?? false;
    menuButton.setAttribute("aria-expanded", String(isOpen));
  });

  document.addEventListener("click", (event) => {
    if (event.target instanceof Node && !navRight?.contains(event.target)) {
      closeMenu();
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      closeMenu();
    }
  });

  themeToggle?.addEventListener("click", () => {
    const nextTheme =
      document.documentElement.dataset.theme === "dark" ? "light" : "dark";

    document.documentElement.dataset.theme = nextTheme;
    document
      .querySelector<HTMLMetaElement>("[data-theme-color]")
      ?.setAttribute("content", nextTheme === "dark" ? "#10141e" : "#ffffff");

    try {
      localStorage.setItem("site-theme", nextTheme);
    } catch {
      // The chosen theme still applies when storage is unavailable.
    }

    updateThemeToggle();
  });

  updateThemeToggle();
  typeCurrentPath();
</script>

<style>
  header {
    position: sticky;
    z-index: 100;
    top: 1rem;
    padding: 0 1rem;
  }
  h2 {
    margin: 0;
    font-size: inherit;
  }
  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.875rem;
    width: 100%;
    max-width: 920px;
    min-height: 36px;
    margin: 0 auto;
    padding: 0.5625rem 0.75rem 0.5625rem 1rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border-light);
    border-radius: 1rem;
    box-shadow:
      0 1px color-mix(in srgb, var(--color-background) 80%, transparent) inset,
      0 12px 14px -20px
        color-mix(in srgb, var(--color-text-strong) 45%, transparent);
    backdrop-filter: blur(14px) saturate(140%);
  }
  .terminal-brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-text-secondary);
    font-family:
      ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.875rem;
    font-weight: 500;
    white-space: nowrap;
    text-decoration: none;
  }
  .brand-icon {
    display: grid;
    place-items: center;
    width: 1.375rem;
    height: 1.375rem;
    color: var(--color-text-inverse);
    background: linear-gradient(135deg, #21b4e1, #7b6cff);
    border-radius: 0.3125rem;
    font-size: 0.5625rem;
    font-weight: 700;
    letter-spacing: -0.12em;
  }
  .cwd {
    color: var(--color-text-secondary);
  }
  .path {
    color: var(--color-accent);
  }
  .cursor {
    width: 0.5rem;
    height: 1rem;
    margin-left: 0.125rem;
    background: var(--color-accent);
    animation: blink 1.05s steps(2, end) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .nav-right,
  .internal-links,
  .social-links {
    display: flex;
    align-items: center;
  }
  .nav-right {
    position: relative;
    gap: 0.7rem;
  }
  .internal-links {
    gap: 1.25rem;
  }
  .social-links a {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .social-links {
    gap: 0.125rem;
  }
  .social-links a,
  .menu-button,
  .theme-toggle {
    width: 2.1rem;
    height: 2.1rem;
    color: var(--color-text-secondary);
    background: transparent;
    border: 0;
    border-radius: 50%;
    cursor: pointer;
    transition:
      color 150ms ease,
      background-color 150ms ease,
      transform 200ms ease;
  }
  .social-links a:hover,
  .menu-button:hover,
  .theme-toggle:hover {
    color: var(--color-text-strong);
    background: var(--color-surface-hover);
    transform: scale(1.1);
  }
  .social-links svg,
  .menu-button svg,
  .theme-toggle svg {
    width: 1.125rem;
    height: 1.125rem;
  }
  .menu-button {
    display: none;
    align-items: center;
    justify-content: center;
  }
  .menu-button svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
  }
  .theme-toggle svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .theme-toggle {
    display: grid;
    place-items: center;
    line-height: 0;
  }
  .theme-icon-sun {
    display: none;
  }
  :global(html[data-theme="dark"]) .theme-icon-moon {
    display: none;
  }
  :global(html[data-theme="dark"]) .theme-icon-sun {
    display: block;
  }
  @media (prefers-reduced-motion: reduce) {
    .cursor {
      animation: none;
    }
  }
  @media (max-width: 640px) {
    header {
      top: 0.75rem;
      padding: 0 0.75rem;
    }
    nav {
      min-height: 52px;
      padding: 0.4375rem 0.5rem 0.4375rem 0.75rem;
    }
    .social-links {
      display: none;
    }
    .nav-right {
      gap: 0;
    }
    .menu-button {
      display: flex;
    }
    .internal-links {
      position: absolute;
      z-index: 110;
      top: calc(100% + 0.75rem);
      right: 0;
      display: none;
      flex-direction: column;
      align-items: stretch;
      gap: 0.125rem;
      min-width: 11rem;
      padding: 0.4375rem;
      background: var(--color-surface-strong);
      border: 1px solid var(--color-border-strong);
      border-radius: 0.875rem;
      box-shadow: 0 1.25rem 3rem -1rem
        color-mix(in srgb, var(--color-text-strong) 35%, transparent);
      backdrop-filter: blur(16px);
    }
    .internal-links.is-open {
      display: flex;
    }
  }
</style>
