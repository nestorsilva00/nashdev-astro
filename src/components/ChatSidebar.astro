<aside
  class="chat-sidebar"
  id="chat-panel"
  aria-labelledby="chat-title"
  aria-hidden="true"
  inert
  data-chat-sidebar
>
  <header class="chat-header">
    <h2 id="chat-title">
      <span class="chat-path" aria-hidden="true">
        <span class="chat-path-prefix">~/</span>
        <span class="chat-path-name">ask</span>
        <span class="chat-cursor"></span>
      </span>
      <span class="sr-only">Ask Nestor</span>
    </h2>
    <button
      class="chat-close"
      type="button"
      aria-label="Close chat"
      data-chat-close
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="m6 6 12 12M18 6 6 18"></path>
      </svg>
    </button>
  </header>

  <div
    class="chat-transcript"
    role="log"
    aria-live="polite"
    aria-relevant="additions"
    data-chat-transcript
  >
    <div class="chat-empty" data-chat-empty>
      <p class="chat-empty-kicker">// ASK ABOUT THIS SITE</p>
      <h3>How can I help?</h3>
      <p>Ask me about my experience, skills, education, or fit for a role.</p>
      <div class="chat-suggestions" aria-label="Suggested questions">
        <button type="button" data-chat-question>
          What are your main technical skills?
        </button>
        <button type="button" data-chat-question>
          What experience is most relevant for a backend role?
        </button>
        <button type="button" data-chat-question>
          Can I paste a job offer so you can assess your fit?
        </button>
      </div>
    </div>
  </div>

  <form class="chat-composer" data-chat-form>
    <label class="sr-only" for="chat-message">Message Ask Nestor</label>
    <div class="composer-field">
      <textarea
        id="chat-message"
        name="message"
        rows="1"
        maxlength="24000"
        placeholder="Message Ask Nestor"
        autocomplete="off"
        data-chat-input></textarea>
      <button
        class="chat-send"
        type="submit"
        aria-label="Send message"
        disabled
        data-chat-send
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 19V5M6 11l6-6 6 6"></path>
        </svg>
      </button>
    </div>
    <p class="composer-note">
      Answers use my published profile. You can paste a complete job offer.
    </p>
  </form>
</aside>

<script>
  type ConversationMessage = {
    role: "user" | "assistant";
    content: string;
  };

  type ChatResponse = {
    answer?: string;
    error?: string;
  };

  const sidebar = document.querySelector<HTMLElement>("[data-chat-sidebar]");
  const toggles =
    document.querySelectorAll<HTMLButtonElement>("[data-chat-toggle]");
  const closeButton =
    sidebar?.querySelector<HTMLButtonElement>("[data-chat-close]");
  const form = sidebar?.querySelector<HTMLFormElement>("[data-chat-form]");
  const input =
    sidebar?.querySelector<HTMLTextAreaElement>("[data-chat-input]");
  const sendButton =
    sidebar?.querySelector<HTMLButtonElement>("[data-chat-send]");
  const transcript = sidebar?.querySelector<HTMLElement>(
    "[data-chat-transcript]",
  );
  const emptyState = sidebar?.querySelector<HTMLElement>("[data-chat-empty]");

  let lastFocusedElement: HTMLElement | null = null;
  let isSending = false;
  const conversation: ConversationMessage[] = [];

  const isOpen = () => document.documentElement.dataset.chatOpen === "true";

  const setOpen = (open: boolean, trigger?: HTMLButtonElement) => {
    if (!sidebar || toggles.length === 0) return;

    document.documentElement.dataset.chatOpen = String(open);
    toggles.forEach((toggle) => {
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute(
        "aria-label",
        open ? "Close Ask Nestor" : "Open Ask Nestor",
      );
    });
    sidebar.setAttribute("aria-hidden", String(!open));
    sidebar.inert = !open;

    if (open) {
      lastFocusedElement =
        trigger ??
        (document.activeElement instanceof HTMLElement
          ? document.activeElement
          : toggles.item(0));
      window.setTimeout(() => input?.focus(), 180);
    } else {
      window.setTimeout(
        () => (lastFocusedElement ?? toggles.item(0))?.focus(),
        140,
      );
    }
  };

  const resizeInput = () => {
    if (!input) return;

    input.style.height = "auto";
    input.style.height = `${Math.min(input.scrollHeight, 160)}px`;
  };

  const updateSendButton = () => {
    if (!input || !sendButton) return;
    sendButton.disabled = isSending || input.value.trim().length === 0;
  };

  const createMessage = (role: "user" | "assistant", content: string) => {
    const article = document.createElement("article");
    article.className = `chat-message chat-message-${role}`;

    const body = document.createElement("p");
    body.className = "message-body";
    body.textContent = content;

    article.append(body);
    return article;
  };

  const addMessage = (role: "user" | "assistant", content: string) => {
    if (!transcript) return;

    emptyState?.remove();
    transcript.append(createMessage(role, content));
    transcript.scrollTo({ top: transcript.scrollHeight, behavior: "smooth" });
  };

  const submitMessage = async (message: string) => {
    const value = message.trim();
    if (!value || !input || isSending) return;

    conversation.push({ role: "user", content: value });
    addMessage("user", value);
    input.value = "";
    resizeInput();

    isSending = true;
    input.readOnly = true;
    sidebar?.setAttribute("aria-busy", "true");
    updateSendButton();

    const pendingMessage = createMessage("assistant", "Thinking…");
    pendingMessage.classList.add("chat-message-pending");
    if (transcript) {
      transcript.append(pendingMessage);
      transcript.scrollTo({
        top: transcript.scrollHeight,
        behavior: "smooth",
      });
    }

    try {
      const response = await fetch("/api/chat", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ messages: conversation }),
      });
      const payload = (await response.json().catch(() => null)) as
        | ChatResponse
        | null;

      if (!response.ok || !payload?.answer) {
        throw new Error(payload?.error || "The chat service did not respond.");
      }

      conversation.push({ role: "assistant", content: payload.answer });
      pendingMessage.remove();
      addMessage("assistant", payload.answer);
    } catch (error) {
      pendingMessage.remove();
      addMessage(
        "assistant",
        error instanceof Error
          ? error.message
          : "The chat service is temporarily unavailable.",
      );
    } finally {
      isSending = false;
      input.readOnly = false;
      sidebar?.removeAttribute("aria-busy");
      updateSendButton();
      input.focus();
    }
  };

  toggles.forEach((toggle) => {
    toggle.addEventListener("click", () => setOpen(!isOpen(), toggle));
  });
  closeButton?.addEventListener("click", () => setOpen(false));

  input?.addEventListener("input", () => {
    resizeInput();
    updateSendButton();
  });

  input?.addEventListener("keydown", (event) => {
    if (event.key === "Enter" && !event.shiftKey) {
      event.preventDefault();
      if (!isSending) form?.requestSubmit();
    }
  });

  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    void submitMessage(input?.value ?? "");
  });

  sidebar?.addEventListener("click", (event) => {
    if (!(event.target instanceof Element)) return;

    const question = event.target.closest<HTMLButtonElement>(
      "[data-chat-question]",
    );

    if (question) {
      void submitMessage(question.textContent ?? "");
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && isOpen()) {
      setOpen(false);
    }
  });

  document.documentElement.dataset.chatOpen = "false";
  resizeInput();
  updateSendButton();
</script>

<style>
  :global(html) {
    --chat-panel-width: min(27rem, 42vw);
  }

  .chat-sidebar {
    position: fixed;
    z-index: 300;
    inset: 0 0 0 auto;
    display: grid;
    width: var(--chat-panel-width);
    height: 100dvh;
    grid-template-rows: auto minmax(0, 1fr) auto;
    color: var(--color-text);
    background: linear-gradient(var(--gradient-page-background)) no-repeat;
    background-color: var(--color-background);
    background-size: 100% 28rem;
    border-left: 1px solid var(--color-border-strong);
    transform: translateX(100%);
    transition: transform 200ms ease;
  }

  :global(html[data-chat-open="true"]) .chat-sidebar {
    transform: translateX(0);
  }

  .chat-header {
    display: flex;
    min-height: 3.75rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0 0.9rem 0 1.15rem;
    background: color-mix(in srgb, var(--color-surface) 94%, transparent);
    border-bottom: 1px solid var(--color-border-strong);
    backdrop-filter: blur(14px) saturate(135%);
  }

  .chat-header h2 {
    margin: 0;
    font-family:
      ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0;
  }

  .chat-path {
    display: inline-flex;
    align-items: center;
  }

  .chat-path-prefix {
    color: var(--color-text-secondary);
  }

  .chat-path-name {
    color: var(--color-accent);
  }

  .chat-cursor {
    width: 0.42rem;
    height: 0.9rem;
    margin-left: 0.3rem;
    background: var(--color-accent);
    animation: chat-cursor-blink 1.05s steps(2, end) infinite;
  }

  @keyframes chat-cursor-blink {
    50% {
      opacity: 0;
    }
  }

  .chat-close {
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    color: var(--color-text-secondary);
    background: transparent;
    border: 0;
    border-radius: 0.45rem;
    cursor: pointer;
  }

  .chat-close:hover {
    color: var(--color-text-strong);
    background: var(--color-surface-hover);
  }

  .chat-close svg,
  .chat-send svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
  }

  .chat-close:focus-visible,
  .chat-send:focus-visible,
  textarea:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .chat-transcript {
    overflow-y: auto;
    padding: 1.5rem 1.25rem;
    overscroll-behavior: contain;
    scrollbar-color: var(--color-border-strong) transparent;
    scrollbar-width: thin;
  }

  .chat-empty {
    display: grid;
    min-height: 100%;
    place-content: center;
    padding-bottom: 3rem;
    text-align: center;
  }

  .chat-empty-kicker {
    margin: 0 0 0.7rem;
    color: var(--color-accent);
    font-family:
      ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    line-height: 1.2;
  }

  .chat-empty h3 {
    margin: 0;
    font-size: 1.45rem;
    font-weight: 700;
    letter-spacing: -0.035em;
  }

  .chat-empty > p:not(.chat-empty-kicker) {
    max-width: 29ch;
    margin: 0.65rem auto 0;
    color: var(--color-text-secondary);
    font-size: 0.8rem;
    line-height: 1.5;
  }

  .chat-suggestions {
    display: grid;
    gap: 0.5rem;
    width: min(100%, 19rem);
    margin: 1.35rem auto 0;
  }

  .chat-suggestions button {
    padding: 0.65rem 0.8rem;
    color: var(--color-text-secondary);
    background: color-mix(
      in srgb,
      var(--color-surface-strong) 82%,
      transparent
    );
    border: 1px solid var(--color-border-strong);
    border-radius: 0.65rem;
    font: inherit;
    font-size: 0.72rem;
    line-height: 1.35;
    text-align: left;
    cursor: pointer;
    transition:
      color 140ms ease,
      border-color 140ms ease,
      background-color 140ms ease;
  }

  .chat-suggestions button:hover {
    color: var(--color-text-strong);
    background: var(--color-surface-hover);
    border-color: color-mix(
      in srgb,
      var(--color-accent) 35%,
      var(--color-border-strong)
    );
  }

  .chat-suggestions button:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  :global(.chat-message) {
    display: flex;
    margin: 0 auto 1.25rem;
  }

  :global(.chat-message-user) {
    justify-content: flex-end;
  }

  :global(.message-body) {
    max-width: 88%;
    margin: 0;
    color: var(--color-text);
    font-size: 0.82rem;
    line-height: 1.6;
    white-space: pre-wrap;
  }

  :global(.chat-message-user .message-body) {
    padding: 0.65rem 0.85rem;
    background: color-mix(
      in srgb,
      var(--color-accent) 10%,
      var(--color-surface-strong)
    );
    border: 1px solid
      color-mix(in srgb, var(--color-accent) 18%, var(--color-border-strong));
    border-radius: 0.75rem;
  }

  :global(.chat-message-assistant .message-body) {
    max-width: 100%;
  }

  :global(.chat-message-pending .message-body) {
    color: var(--color-text-muted);
    animation: chat-thinking 1.1s ease-in-out infinite alternate;
  }

  @keyframes chat-thinking {
    to {
      opacity: 0.45;
    }
  }

  .chat-composer {
    padding: 0.75rem 0.85rem 0.65rem;
    background: var(--color-background);
  }

  .composer-field {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.55rem;
    align-items: end;
    padding: 0.45rem 0.45rem 0.45rem 0.9rem;
    background: var(--color-surface-strong);
    border: 1px solid var(--color-border-strong);
    border-radius: 0.8rem;
    box-shadow: 0 2px 10px
      color-mix(in srgb, var(--color-text-strong) 6%, transparent);
  }

  .composer-field:focus-within {
    border-color: color-mix(
      in srgb,
      var(--color-text-secondary) 60%,
      var(--color-border-strong)
    );
  }

  textarea {
    width: 100%;
    min-height: 2rem;
    max-height: 10rem;
    resize: none;
    overflow-y: auto;
    padding: 0.35rem 0;
    color: var(--color-text);
    background: transparent;
    border: 0;
    font: inherit;
    font-size: 0.8rem;
    line-height: 1.45;
  }

  textarea::placeholder {
    color: var(--color-text-muted);
  }

  textarea:focus {
    outline: 0;
  }

  .chat-send {
    display: grid;
    width: 2.15rem;
    height: 2.15rem;
    place-items: center;
    color: var(--color-text-inverse);
    background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
    border: 0;
    border-radius: 0.55rem;
    cursor: pointer;
    transition: opacity 140ms ease;
  }

  .chat-send:disabled {
    cursor: default;
    opacity: 0.25;
  }

  .composer-note {
    margin: 0.45rem 0 0;
    color: var(--color-text-muted);
    font-size: 0.58rem;
    line-height: 1.4;
    text-align: center;
  }

  @media (min-width: 1100px) {
    :global(body) {
      transition: padding-right 200ms ease;
    }

    :global(html[data-chat-open="true"] body) {
      padding-right: var(--chat-panel-width);
    }
  }

  @media (max-width: 720px) {
    :global(html) {
      --chat-panel-width: 100vw;
    }

    .chat-sidebar {
      border-left: 0;
      box-shadow: none;
    }

    .chat-transcript {
      padding: 1.25rem 1rem;
    }

    .chat-composer {
      padding-bottom: max(0.65rem, env(safe-area-inset-bottom));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .chat-sidebar,
    :global(body),
    .chat-send,
    .chat-cursor,
    :global(.chat-message-pending .message-body) {
      transition: none;
      animation: none;
    }
  }
</style>
