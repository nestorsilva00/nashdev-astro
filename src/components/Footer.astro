---
import SocialLinks from "./SocialLinks.astro";

const today = new Date();
---

<footer data-reveal>
  &copy; {today.getFullYear()} Nestor Silva. All rights reserved.
  <SocialLinks variant="footer" />
</footer>
<style>
  footer {
    padding: 2em 1em 6em 1em;
    background: linear-gradient(var(--gradient-page-background)) no-repeat;
    color: var(--color-text-secondary);
    text-align: center;
  }
</style>
