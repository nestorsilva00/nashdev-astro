# Cloudflare deployment uses the AI binding and variables in wrangler.jsonc.
# Use this file only when switching to an OpenAI-compatible HTTP provider.
CHAT_PROVIDER=openai-compatible
CHAT_BASE_URL=http://127.0.0.1:11434/v1
CHAT_MODEL=qwen3:4b

# Leave empty for local providers such as Ollama.
CHAT_API_KEY=

# Optional generation settings.
CHAT_TEMPERATURE=0.2
CHAT_MAX_TOKENS=500
CHAT_TIMEOUT_MS=45000

# Optional. A built-in portfolio assistant prompt is used when omitted.
# CHAT_SYSTEM_PROMPT=
